{
  "name": "peel-net",
  "version": "0.1.0",
  "description": "Open-source .NET deobfuscator that runs in your browser. Your assemblies never leave your device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peel-net": "bin/peel-net.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/engine/",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLCForge/Peel-NET.git"
  },
  "homepage": "https://github.com/LLCForge/Peel-NET#readme",
  "keywords": [
    "deobfuscator",
    "dotnet",
    ".net",
    "csharp",
    "confuserex",
    "decompiler",
    "malware-analysis",
    "security",
    "webassembly"
  ],
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.js",
    "dev": "node scripts/build-engine.js && vite",
    "build": "node scripts/build-engine.js && vite build",
    "preview": "vite preview",
    "fixtures": "node scripts/make-fixtures.js",
    "test": "node scripts/build-engine.js && node test/run.js && node test/all.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "vite": "^6.4.6"
  }
}
